{
  "name": "itd-hackathon",
  "version": "1.0.0",
  "description": "AI Shipping Copilot - ITD Hackathon 2025",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && go run main.go config.go",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && go build -o app",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && go mod tidy",
    "setup": "npm run install:frontend && npm run install:backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["shipping", "ai", "logistics", "nextjs", "go", "typescript"],
  "author": "ITD Hackathon Team",
  "license": "MIT"
} 